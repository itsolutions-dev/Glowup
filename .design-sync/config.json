{
  "pkg": "@glowup/ui",
  "projectId": "c02682fc-2db9-465f-b4c0-1d7581b437ec",
  "globalName": "GlowupUI",
  "shape": "package",
  "buildCmd": "npm run build",
  "provider": {
    "component": "SafeAreaProvider",
    "inner": {
      "component": "ThemeProvider",
      "inner": {
        "component": "AlertProvider"
      }
    }
  },
  "componentSrcMap": {
    "DrawerNavigation": null,
    "StackNavigation": null,
    "CustomDrawerContent": null,
    "Alert": null,
    "SafeAreaProvider": null,
    "FAB": "src/components/FAB.tsx"
  },
  "docsDir": "../../.design-sync/docs",
  "guidelinesGlob": [
    "../../.design-sync/guidelines/*.md"
  ],
  "libOverrides": {
    "source-kit.mjs": "Glowup's List/ Modal/ Progress/ Tab/ ToggleButton/ src dirs are file organisation, not DS groups",
    "dts.mjs": "allowlist the all-caps component name FAB (ALL-CAPS-means-constant rule would drop it)"
  },
