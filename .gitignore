# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# build output (packages/*/lib is generated by `bob build` on publish)
lib/
!src/**/lib/

# generated native folders
**/ios/
**/android/
**/build/
# …but a vendor package's Android module (RFID, barcode scanner) is source.
!packages/rfid-*/android/
!packages/scanner-*/android/

# The workspaces' lockfile is committed; the smoke app's is not (it must resolve
# the published package and its peers fresh, the way a new app would).
examples/consumer/package-lock.json

.claude
.vscode/*
!.vscode/settings.json
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# design-sync generated artifacts (regenerated by the committed scripts)
packages/ui/.design-sync-entry.mjs
.design-sync/web-barrel.mjs
.design-sync/docs/
.design-sync/guidelines/

# local tool state (code graphs, indexes, agent caches)
.tokensave/
.serena/
graphify-out/

# The Honeywell SDKs (RFID, and the Data Collection SDK it and the barcode
# scanner load): their licence lets them travel only inside an app's build
# (docs/device-package-plan.md, "The licence"). Never commit a copy.
honeywell_rfid_sdk*.aar
DataCollection*.aar
honeywell-rfid-repository/
honeywell-scanner-repository/
# Zebra's RFID SDK for Android: from Zebra's support portal, not a public
# repository; it travels only inside an app's build, like Honeywell's.
rfidapi3*.aar
API3_*.aar
zebra-rfid-repository/
