{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "types": ["jest"],
    // The packages are consumed through their package names only — never through
    // a deep path into packages/*. Each mapping points at the source barrel so
    // Metro and tsc stay in sync with a live edit in the package; ESLint's
    // no-restricted-imports rule blocks every other route into them.
    "paths": {
      "@its/glowup-ui": ["../../packages/ui/src/index.ts"],
      "@its/glowup-notifications": [
        "../../packages/notifications/src/index.ts"
      ],
      "@its/glowup-device": ["../../packages/device/src/index.ts"],
      "@its/glowup-device/info": ["../../packages/device/src/info/index.ts"],
      "@its/glowup-device/location": [
        "../../packages/device/src/location/index.ts"
      ],
      "@its/glowup-device/camera": [
        "../../packages/device/src/camera/index.ts"
      ],
      "@its/glowup-device/testing": [
        "../../packages/device/src/testing/index.ts"
      ]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
