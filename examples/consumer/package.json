{
  "name": "glowup-consumer-smoke",
  "version": "0.0.0",
  "private": true,
  "description": "Deliberately OUTSIDE the npm workspaces: installs @its/glowup-ui and @its/glowup-device from the registry so the published artefacts are exercised, not the local source.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "type-check": "tsc --noEmit",
    "smoke": "npm run type-check && expo export -p web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@its/glowup-device": "0.x",
    "@its/glowup-ui": "0.x",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.25",
    "expo-application": "~57.0.3",
    "expo-battery": "~57.0.3",
    "expo-camera": "~57.0.5",
    "expo-device": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-screen-orientation": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.17",
    "typescript": "~6.0.3"
  }
}
