{
  "name": "glowup-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "homepage": "https://itsolutions-dev.github.io/Glowup/",
  "scripts": {
    "start": "npm start -w @its/glowup-playground",
    "playground": "npm start -w @its/glowup-playground",
    "android": "npm run android -w @its/glowup-playground",
    "ios": "npm run ios -w @its/glowup-playground",
    "web": "npm run web -w @its/glowup-playground",
    "lint": "eslint .",
    "type-check": "npm run type-check --workspaces --if-present && tsc --noEmit -p .design-sync/tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspace @its/glowup-ui",
    "version-packages": "changeset version && npm run docgen -w @its/glowup-playground",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  }
}