{
  "name": "@its/glowup-charts",
  "version": "0.0.0",
  "private": true,
  "description": "Charts for Expo apps, built on @its/glowup-ui and react-native-svg: bars, lines, areas, donuts and sparklines on web, iOS and Android",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsolutions-dev/Glowup.git",
    "directory": "packages/charts"
  },
  "homepage": "https://github.com/itsolutions-dev/Glowup/tree/master/packages/charts#readme",
  "bugs": {
    "url": "https://github.com/itsolutions-dev/Glowup/issues"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "source": "src/index.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "default": "./lib/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/*.map",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bob build && node ../../scripts/strip-declaration-maps.mjs",
    "validate-package": "publint && attw --pack .",
    "clean": "del-cli lib",
    "prepack": "npm run build",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests"
  },
  "keywords": [
    "react-native",
    "expo",
    "charts",
    "svg",
    "bar-chart",
    "line-chart",
    "donut-chart"
  ],
  "peerDependencies": {
    "@its/glowup-ui": ">=0.11",
    "react": ">=19",
    "react-native": ">=0.86",
    "react-native-svg": ">=15"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@its/glowup-ui": "*",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.17",
    "babel-preset-expo": "~57.0.1",
    "del-cli": "^7.0.0",
    "expo": "~57.0.25",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "publint": "^0.3.25",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-builder-bob": "^0.43.2",
    "react-native-svg": "15.15.4",
    "test-renderer": "^1.3.1"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "sourceMaps": false
        }
      ],
      [
        "module",
        {
          "sourceMaps": false
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testTimeout": 30000
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
