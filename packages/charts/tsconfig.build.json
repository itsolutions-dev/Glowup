{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "types": [],
    // The declarations name the library's package, not its source: with the
    // mapping inherited from tsconfig.json, tsc would pull packages/ui/src outside
    // `rootDir`.
    "paths": {}
  },
  "include": ["src"],
  "exclude": ["**/__tests__", "**/*.test.ts", "**/*.test.tsx"]
}
