{
  "name": "@its/glowup-device",
  "version": "0.5.0",
  "description": "Headless device hardware layer for Expo apps: location, camera, network, battery, haptics, biometrics, secure storage, sensors and more behind swappable adapters",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsolutions-dev/Glowup.git",
    "directory": "packages/device"
  },
  "homepage": "https://github.com/itsolutions-dev/Glowup/tree/master/packages/device#readme",
  "bugs": {
    "url": "https://github.com/itsolutions-dev/Glowup/issues"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "source": "src/index.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "default": "./lib/commonjs/index.js"
    },
    "./info": {
      "source": "./src/info/index.ts",
      "types": "./lib/typescript/info/index.d.ts",
      "default": "./lib/commonjs/info/index.js"
    },
    "./location": {
      "source": "./src/location/index.ts",
      "types": "./lib/typescript/location/index.d.ts",
      "default": "./lib/commonjs/location/index.js"
    },
    "./camera": {
      "source": "./src/camera/index.ts",
      "types": "./lib/typescript/camera/index.d.ts",
      "default": "./lib/commonjs/camera/index.js"
    },
    "./network": {
      "source": "./src/network/index.ts",
      "types": "./lib/typescript/network/index.d.ts",
      "default": "./lib/commonjs/network/index.js"
    },
    "./battery": {
      "source": "./src/battery/index.ts",
      "types": "./lib/typescript/battery/index.d.ts",
      "default": "./lib/commonjs/battery/index.js"
    },
    "./keep-awake": {
      "source": "./src/keep-awake/index.ts",
      "types": "./lib/typescript/keep-awake/index.d.ts",
      "default": "./lib/commonjs/keep-awake/index.js"
    },
    "./orientation": {
      "source": "./src/orientation/index.ts",
      "types": "./lib/typescript/orientation/index.d.ts",
      "default": "./lib/commonjs/orientation/index.js"
    },
    "./haptics": {
      "source": "./src/haptics/index.ts",
      "types": "./lib/typescript/haptics/index.d.ts",
      "default": "./lib/commonjs/haptics/index.js"
    },
    "./biometrics": {
      "source": "./src/biometrics/index.ts",
      "types": "./lib/typescript/biometrics/index.d.ts",
      "default": "./lib/commonjs/biometrics/index.js"
    },
    "./secure-store": {
      "source": "./src/secure-store/index.ts",
      "types": "./lib/typescript/secure-store/index.d.ts",
      "default": "./lib/commonjs/secure-store/index.js"
    },
    "./sensors": {
      "source": "./src/sensors/index.ts",
      "types": "./lib/typescript/sensors/index.d.ts",
      "default": "./lib/commonjs/sensors/index.js"
    },
    "./media-picker": {
      "source": "./src/media-picker/index.ts",
      "types": "./lib/typescript/media-picker/index.d.ts",
      "default": "./lib/commonjs/media-picker/index.js"
    },
    "./media-library": {
      "source": "./src/media-library/index.ts",
      "types": "./lib/typescript/media-library/index.d.ts",
      "default": "./lib/commonjs/media-library/index.js"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./lib/typescript/testing/index.d.ts",
      "default": "./lib/commonjs/testing/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "info",
    "location",
    "camera",
    "network",
    "battery",
    "keep-awake",
    "orientation",
    "haptics",
    "biometrics",
    "secure-store",
    "sensors",
    "media-picker",
    "media-library",
    "testing",
    "app.plugin.js",
    "!**/*.map",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bob build && node ../../scripts/strip-declaration-maps.mjs",
    "validate-package": "publint && attw --pack . --exclude-entrypoints ./app.plugin.js",
    "clean": "del-cli lib",
    "prepack": "npm run build",
    "type-check": "tsc --noEmit",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "expo",
    "headless",
    "device",
    "location",
    "camera",
    "device-info",
    "network",
    "battery",
    "keep-awake",
    "orientation",
    "haptics",
    "biometrics",
    "secure-store",
    "sensors",
    "media-picker",
    "media-library"
  ],
  "peerDependencies": {
    "@react-native-community/netinfo": ">=12",
    "expo": ">=57",
    "expo-application": ">=57",
    "expo-battery": ">=57",
    "expo-camera": ">=57",
    "expo-device": ">=57",
    "expo-haptics": ">=57",
    "expo-image-picker": ">=57",
    "expo-keep-awake": ">=57",
    "expo-local-authentication": ">=57",
    "expo-location": ">=57",
    "expo-media-library": ">=57",
    "expo-screen-orientation": ">=57",
    "expo-secure-store": ">=57",
    "expo-sensors": ">=57",
    "react": ">=19",
    "react-native": ">=0.86"
  },
  "peerDependenciesMeta": {
    "@react-native-community/netinfo": {
      "optional": true
    },
    "expo-application": {
      "optional": true
    },
    "expo-battery": {
      "optional": true
    },
    "expo-camera": {
      "optional": true
    },
    "expo-device": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    },
    "expo-image-picker": {
      "optional": true
    },
    "expo-keep-awake": {
      "optional": true
    },
    "expo-local-authentication": {
      "optional": true
    },
    "expo-location": {
      "optional": true
    },
    "expo-media-library": {
      "optional": true
    },
    "expo-screen-orientation": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "expo-sensors": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2",
    "babel-preset-expo": "~57.0.1",
    "del-cli": "^7.0.0",
    "expo": "~57.0.25",
    "expo-application": "~57.0.3",
    "expo-battery": "~57.0.3",
    "expo-camera": "~57.0.5",
    "expo-device": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.20",
    "expo-media-library": "~57.0.5",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sensors": "~57.0.3",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "publint": "^0.3.25",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-builder-bob": "^0.43.2",
    "test-renderer": "^1.3.1"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "sourceMaps": false
        }
      ],
      [
        "module",
        {
          "sourceMaps": false
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testTimeout": 30000
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
