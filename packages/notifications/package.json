{
  "name": "@its/glowup-notifications",
  "version": "0.3.0",
  "description": "Headless push notification layer for Expo apps: permissions, push tokens, foreground policy, taps and Android channels",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsolutions-dev/Glowup.git",
    "directory": "packages/notifications"
  },
  "homepage": "https://github.com/itsolutions-dev/Glowup/tree/master/packages/notifications#readme",
  "bugs": {
    "url": "https://github.com/itsolutions-dev/Glowup/issues"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "source": "src/index.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "default": "./lib/commonjs/index.js"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./lib/typescript/testing/index.d.ts",
      "default": "./lib/commonjs/testing/index.js"
    },
    "./service-worker.js": "./service-worker/glowup-push-sw.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "testing",
    "service-worker",
    "!**/*.map",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bob build && node ../../scripts/strip-declaration-maps.mjs",
    "validate-package": "publint && attw --pack . --exclude-entrypoints ./service-worker.js",
    "clean": "del-cli lib",
    "prepack": "npm run build",
    "type-check": "tsc --noEmit",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-notifications",
    "push-notifications",
    "headless",
    "web-push"
  ],
  "peerDependencies": {
    "expo-notifications": ">=57",
    "react": ">=19",
    "react-native": ">=0.86"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.17",
    "babel-preset-expo": "~57.0.1",
    "del-cli": "^7.0.0",
    "expo-notifications": "~57.0.21",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "publint": "^0.3.25",
    "react-native-builder-bob": "^0.43.2",
    "test-renderer": "^1.3.1"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "sourceMaps": false
        }
      ],
      [
        "module",
        {
          "sourceMaps": false
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testTimeout": 30000
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
