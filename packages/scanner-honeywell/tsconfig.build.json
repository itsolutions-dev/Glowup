{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "types": [],
    // The published types import the device package by name, from its build
    // (`npm run build` builds it first).
    "paths": {}
  },
  "include": ["src"],
  "exclude": ["**/__tests__", "**/*.test.ts", "**/*.test.tsx"]
}
