{
  "name": "@its/glowup-ui",
  "version": "0.4.1",
  "description": "Material You (Material Design 3) component library for React Native + Web (Expo)",
  "license": "MIT",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "source": "src/index.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "default": "./lib/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/*.map",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/components.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bob build && node scripts/strip-declaration-maps.mjs",
    "validate-package": "publint && attw --pack .",
    "clean": "del-cli lib",
    "prepack": "npm run build",
    "type-check": "tsc --noEmit",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "expo",
    "material-design",
    "material-you",
    "material-design-3",
    "component-library",
    "ui-kit"
  ],
  "dependencies": {
    "date-fns": "^4.4.0",
    "polished": "^4.3.1"
  },
  "peerDependencies": {
    "@expo/vector-icons": ">=15",
    "@react-navigation/drawer": ">=7",
    "@react-navigation/native": ">=7",
    "@react-navigation/native-stack": ">=7",
    "expo-localization": ">=57 || >=15",
    "expo-status-bar": ">=57 || >=2",
    "react": ">=19",
    "react-dom": ">=19",
    "react-native": ">=0.86",
    "react-native-safe-area-context": ">=5",
    "react-native-svg": ">=15"
  },
  "peerDependenciesMeta": {
    "@react-navigation/drawer": {
      "optional": true
    },
    "@react-navigation/native": {
      "optional": true
    },
    "@react-navigation/native-stack": {
      "optional": true
    },
    "expo-localization": {
      "optional": true
    },
    "expo-status-bar": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2",
    "babel-preset-expo": "~57.0.1",
    "del-cli": "^7.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "publint": "^0.3.24",
    "react-native-builder-bob": "^0.43.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "sourceMaps": false
        }
      ],
      [
        "module",
        {
          "sourceMaps": false
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testTimeout": 30000
  }
}
